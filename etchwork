#!/bin/sh
# Etchwork CLI. Resolves its own root through symlinks, so a link on PATH works.
set -eu
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ETCHWORK_ROOT=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
export ETCHWORK_ROOT
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  init)   exec "$ETCHWORK_ROOT/libexec/init.sh" "$@" ;;
  build)  exec "$ETCHWORK_ROOT/libexec/build.sh" "$@" ;;
  test)   exec "$ETCHWORK_ROOT/libexec/test.sh" "$@" ;;
  check)  exec "$ETCHWORK_ROOT/libexec/check.sh" "$@" ;;
  job)    exec "$ETCHWORK_ROOT/libexec/job.sh" "$@" ;;
  contract) exec "$ETCHWORK_ROOT/libexec/contract.sh" "$@" ;;
  runner) sub="${1:-}"; [ $# -gt 0 ] && shift
          [ "$sub" = build ] || { echo "usage: etchwork runner build [--agent-bin <path>]" >&2; exit 2; }
          exec "$ETCHWORK_ROOT/libexec/runner-build.sh" "$@" ;;
  help|-h|--help)
    cat <<'EOF'
etchwork init <dir> [--client claude-code|codex|flai] [--build]
                                     without --client: the agent whose config the
                                     folder already has, else the only one on PATH,
                                     else asks
etchwork build                      build the engine image
etchwork test                       run the engine test suite in the image
etchwork check                      build, then run every test suite (engine,
                                     CONTRACT, CLI, export, job)
etchwork runner build [--agent-bin <path>]
                                     needs a Linux flai binary (no other agent yet)
etchwork job <runner tag> <job dir> [--probes]
                                     requires ETCHWORK_EGRESS_IMAGE=<egress tag>
                                     and OPENROUTER_API_KEY=<key>; reads
                                     <job dir>/prompt.txt; writes to <job dir>.out/
etchwork contract score <task> <board dir> [--out <file>]
                                     grade a delivered board against a CONTRACT
                                     task (see contract/README.md)
etchwork contract test [pytest args] run CONTRACT's tests in the engine image
etchwork contract fixtures           regenerate CONTRACT's fixture boards
EOF
    ;;
  *) echo "unknown command: $cmd (try: etchwork help)" >&2; exit 2 ;;
esac
